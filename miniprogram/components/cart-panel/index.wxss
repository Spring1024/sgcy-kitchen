.mask { position: fixed; inset: 0; z-index: 60; background: rgba(0,0,0,0.5); }
.panel {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 61;
  background: #fff; border-radius: 32rpx 32rpx 0 0;
  max-height: 70vh; display: flex; flex-direction: column;
}
.panel-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 32rpx; border-bottom: 1rpx solid rgba(55,6,23,0.05);
}
.panel-title { font-size: 30rpx; font-weight: bold; color: #370617; }
.panel-sub { font-size: 22rpx; color: rgba(55,6,23,0.4); font-weight: normal; margin-left: 8rpx; }
.panel-actions { display: flex; align-items: center; gap: 16rpx; }
.clear-btn { font-size: 22rpx; color: rgba(55,6,23,0.5); padding: 8rpx 20rpx; }
.close-btn {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: rgba(55,6,23,0.05); text-align: center; line-height: 56rpx;
}
.panel-body { flex: 1; padding: 20rpx 32rpx; }
.panel-empty { text-align: center; color: rgba(55,6,23,0.35); padding: 80rpx 0; font-size: 26rpx; }
.cart-item {
  display: flex; align-items: center; gap: 20rpx;
  background: #FFF8F0; border-radius: 20rpx; padding: 20rpx; margin-bottom: 20rpx;
}
.cart-img { width: 112rpx; height: 112rpx; border-radius: 16rpx; flex-shrink: 0; }
.cart-info { flex: 1; min-width: 0; }
.cart-name { font-size: 26rpx; font-weight: bold; color: #370617; }
.cart-spec { font-size: 20rpx; color: rgba(55,6,23,0.45); margin-top: 4rpx; }
.cart-price { color: #E85D04; font-weight: bold; margin-top: 8rpx; }
.qty-ctrl { display: flex; align-items: center; gap: 14rpx; background: #fff; border-radius: 999rpx; padding: 6rpx 12rpx; }
.qty-btn {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  border: 1rpx solid rgba(232,93,4,0.3); color: #E85D04;
  display: flex; align-items: center; justify-content: center; font-size: 26rpx;
}
.qty-plus { background: #E85D04; color: #fff; }
.qty-num { font-size: 26rpx; font-weight: bold; min-width: 36rpx; text-align: center; color: #370617; }
.panel-footer { padding: 20rpx 32rpx 48rpx; border-top: 1rpx solid rgba(55,6,23,0.05); }
.checkout-btn {
  background: #370617; color: #fff; border-radius: 24rpx;
  padding: 28rpx 40rpx; display: flex; justify-content: space-between; font-size: 28rpx;
}
.checkout-disabled { background: rgba(55,6,23,0.1); color: rgba(55,6,23,0.4); }
