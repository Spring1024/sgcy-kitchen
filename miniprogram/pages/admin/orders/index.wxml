<loading-mask show="{{loading}}" />
<view class="admin-container">
  <view class="admin-header">
    <view class="admin-title">订单管理</view>
    <view class="admin-sub">到店订单 · 共 {{orders.length}} 单</view>
  </view>

  <view class="page">
    <view class="filter-row">
      <view
        wx:for="{{tabs}}" wx:key="key"
        class="filter-chip {{tab === item.key ? 'active' : ''}}"
        bindtap="setTab" data-key="{{item.key}}"
      >{{item.label}}</view>
    </view>

    <view wx:if="{{filtered.length === 0}}" class="empty">暂无相关订单</view>

    <view class="order-card" wx:for="{{filtered}}" wx:key="orderId" bindtap="goDetail" data-id="{{item.orderId}}">
      <view class="order-head">
        <view>
          <text class="status-chip st-{{item.status}}">{{item.statusText}}</text>
          <text class="order-type">{{item.type === 'today' ? '到店 · 今天' : '预约'}}</text>
        </view>
        <text class="order-id">{{item.orderId}}</text>
      </view>
      <view class="order-items">
        <view class="oi" wx:for="{{item.items}}" wx:for-item="it" wx:key="name">
          <text class="oi-name">{{it.name}}</text>
          <text class="oi-qty">x{{it.quantity}}</text>
        </view>
      </view>
      <view class="order-foot">
        <view>
          <text class="order-total">¥{{item.total}}</text>
          <text class="order-time">{{item.timeLabel}}</text>
        </view>
        <view class="order-actions" catchtap="noop">
          <view wx:if="{{item.status === 'pending'}}" class="btn btn-yellow" catchtap="update" data-id="{{item.orderId}}" data-status="cooking">开始备餐</view>
          <view wx:if="{{item.status === 'cooking'}}" class="btn btn-teal" catchtap="update" data-id="{{item.orderId}}" data-status="done">标记完成</view>
          <view wx:if="{{item.status === 'pending' || item.status === 'cooking'}}" class="btn btn-ghost" catchtap="cancel" data-id="{{item.orderId}}">取消</view>
        </view>
      </view>
    </view>
  </view>

  <view class="admin-tabbar">
    <view class="atab" bindtap="goPage" data-url="/pages/admin/menu/index">🍜<text>菜品</text></view>
    <view class="atab active">📋<text>订单</text></view>
    <view class="atab" bindtap="goPage" data-url="/pages/admin/profile/index">👤<text>我的</text></view>
  </view>
</view>
