.admin-container { min-height: 100vh; background: #FAF3EC; padding-bottom: 140rpx; }
.admin-header {
  background: linear-gradient(135deg, #1B1A16, #370617);
  padding: 60rpx 40rpx 40rpx; color: #fff;
}
.admin-title { font-size: 36rpx; font-weight: bold; }
.admin-sub { font-size: 22rpx; color: rgba(247,225,215,0.5); margin-top: 8rpx; }
.page { padding: 24rpx 32rpx; }
.filter-row { display: flex; gap: 12rpx; overflow-x: auto; margin-bottom: 20rpx; }
.filter-chip {
  flex-shrink: 0; padding: 12rpx 28rpx; border-radius: 999rpx;
  font-size: 24rpx; background: #fff; color: rgba(55,6,23,0.5);
}
.filter-chip.active { background: #E85D04; color: #fff; font-weight: bold; }
.empty { text-align: center; color: rgba(55,6,23,0.4); padding: 120rpx 0; }
.order-card {
  background: #fff; border-radius: 24rpx; padding: 24rpx; margin-bottom: 20rpx;
  border: 1rpx solid rgba(55,6,23,0.05);
}
.order-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.status-chip { font-size: 20rpx; padding: 4rpx 16rpx; border-radius: 999rpx; margin-right: 12rpx; }
.st-pending { background: rgba(232,93,4,0.1); color: #E85D04; }
.st-cooking { background: rgba(255,183,3,0.15); color: #B17C00; }
.st-done { background: rgba(42,157,143,0.1); color: #2A9D8F; }
.st-cancelled { background: rgba(55,6,23,0.08); color: rgba(55,6,23,0.4); }
.order-type { font-size: 20rpx; color: rgba(55,6,23,0.4); }
.order-id { font-size: 20rpx; color: rgba(55,6,23,0.4); }
.oi { display: flex; justify-content: space-between; font-size: 24rpx; padding: 6rpx 0; }
.oi-name { color: #1B1A16; }
.oi-qty { color: rgba(55,6,23,0.4); }
.order-foot {
  display: flex; justify-content: space-between; align-items: center;
  border-top: 1rpx solid rgba(55,6,23,0.05); padding-top: 16rpx; margin-top: 8rpx;
}
.order-total { color: #E85D04; font-weight: bold; font-size: 28rpx; }
.order-time { font-size: 20rpx; color: rgba(55,6,23,0.4); margin-left: 16rpx; }
.order-actions { display: flex; gap: 12rpx; }
.btn { padding: 12rpx 24rpx; border-radius: 12rpx; font-size: 22rpx; font-weight: bold; }
.btn-yellow { background: #FFB703; color: #fff; }
.btn-teal { background: #2A9D8F; color: #fff; }
.btn-ghost { background: rgba(55,6,23,0.05); color: rgba(55,6,23,0.5); }

.admin-tabbar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
  background: rgba(27,26,22,0.95); border-top: 1rpx solid rgba(232,93,4,0.15);
  display: flex; justify-content: space-around; padding: 12rpx 0 28rpx;
}
.atab {
  display: flex; flex-direction: column; align-items: center; gap: 4rpx;
  font-size: 28rpx; color: rgba(247,225,215,0.4);
}
.atab text { font-size: 20rpx; }
.atab.active { color: #E85D04; font-weight: bold; }
