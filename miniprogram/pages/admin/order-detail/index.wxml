<view class="admin-container" wx:if="{{order}}">
  <view class="admin-header">
    <view class="admin-sub">订单号</view>
    <view class="admin-title">{{order.orderId}}</view>
    <view class="status-chip st-{{order.status}}" style="margin-top:16rpx;display:inline-block">{{order.statusText}}</view>
  </view>

  <view class="page">
    <view class="card">
      <view class="row"><text class="label">取餐方式</text><text>{{order.type === 'today' ? '当天到店' : '预约到店'}}</text></view>
      <view class="row"><text class="label">到店时间</text><text>{{order.timeLabel}}</text></view>
      <view class="row"><text class="label">联系顾客</text><text>{{order.phone || '未留电话'}}</text></view>
      <view class="row" wx:if="{{order.remark}}"><text class="label">备注</text><text>{{order.remark}}</text></view>
    </view>

    <view class="card">
      <view class="card-title">菜品明细</view>
      <view class="dish" wx:for="{{order.items}}" wx:key="name">
        <view class="dish-qty-badge">{{item.quantity}}</view>
        <view class="dish-info">
          <view class="dish-name">{{item.name}}</view>
          <view wx:if="{{item.specText}}" class="dish-spec">{{item.specText}}</view>
        </view>
        <text class="dish-sub">¥{{item.price * item.quantity}}</text>
      </view>
      <view class="row total-row">
        <text class="label">共 {{totalQty}} 件</text>
        <text class="total">合计 ¥{{order.total}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{order.status !== 'cancelled' && order.status !== 'done'}}" class="bottom-bar">
    <view wx:if="{{order.status === 'pending'}}" class="bar-btn btn-yellow" bindtap="update" data-status="cooking">开始备餐</view>
    <view wx:if="{{order.status === 'cooking'}}" class="bar-btn btn-teal" bindtap="update" data-status="done">标记完成</view>
    <view class="bar-btn btn-ghost" bindtap="cancel">取消订单</view>
  </view>

  <view class="admin-tabbar">
    <view class="atab" bindtap="goPage" data-url="/pages/admin/menu/index">🍜<text>菜品</text></view>
    <view class="atab active" bindtap="goPage" data-url="/pages/admin/orders/index">📋<text>订单</text></view>
    <view class="atab" bindtap="goPage" data-url="/pages/admin/profile/index">👤<text>我的</text></view>
  </view>
</view>
