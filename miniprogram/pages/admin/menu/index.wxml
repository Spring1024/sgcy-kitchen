<loading-mask show="{{loading}}" />
<view class="admin-container">
  <wxs module="util">
module.exports.isSpecAdded = function(specs, label) {
  for (var i = 0; i < specs.length; i++) {
    if (specs[i].label === label) return true;
  }
  return false;
};
</wxs>
  <view class="admin-header">
    <view class="admin-title">菜品管理</view>
    <view class="admin-sub">在售 {{onlineCount}} / 共 {{items.length}} 道</view>
  </view>

  <view class="page">
    <view class="search-box">
      <input class="search-input" placeholder="搜索菜品名称或分类" value="{{query}}" bindinput="onSearch" />
    </view>

    <view class="add-btn" bindtap="onAdd">＋ 新增菜品</view>

    <view class="dish" wx:for="{{filtered}}" wx:key="_id">
      <image class="dish-img" src="{{item.image}}" mode="aspectFill" />
      <view class="dish-info">
        <view class="dish-name">
          {{item.name}}
          <text wx:if="{{!item.online}}" class="off-badge">已下架</text>
        </view>
        <view class="dish-meta">{{item.category}} · 库存 {{item.stock}} · 售 {{item.sold}}</view>
        <view class="dish-price">¥{{item.price}}</view>
      </view>
      <view class="dish-actions">
        <view class="act-btn" catchtap="onEdit" data-item="{{item}}">✏️</view>
        <view class="switch {{item.online ? 'switch-on' : ''}}" catchtap="onToggle" data-id="{{item._id}}" data-online="{{item.online}}">
          <view class="switch-dot"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 编辑/新增弹窗 -->
  <view wx:if="{{showForm}}" class="modal-mask" bindtap="closeForm">
    <view class="form-sheet" catchtap="noop">
      <view class="form-head">
        <text class="form-title">{{form._id ? '编辑菜品' : '新增菜品'}}</text>
        <text class="form-close" catchtap="closeForm">✕</text>
      </view>
      <scroll-view scroll-y class="form-body scroll-hide">
        <view class="field">
          <text class="field-label">菜品名称</text>
          <input class="field-input" value="{{form.name}}" data-field="name" bindinput="onField" placeholder="如：麻辣香锅" />
        </view>
        <view class="field">
          <text class="field-label">分类</text>
          <view class="cat-row">
            <view
              wx:for="{{categories}}" wx:key="*this"
              class="cat-chip {{form.category === item ? 'active' : ''}}"
              data-cat="{{item}}" bindtap="onCatSelect"
            >{{item}}</view>
          </view>
        </view>
        <view class="field-row">
          <view class="field half">
            <text class="field-label">价格 (¥)</text>
            <input class="field-input" type="digit" value="{{form.price}}" data-field="price" bindinput="onField" />
          </view>
          <view class="field half">
            <text class="field-label">库存</text>
            <input class="field-input" type="number" value="{{form.stock}}" data-field="stock" bindinput="onField" />
          </view>
        </view>
        <view class="field">
          <text class="field-label">菜品图片</text>
          <view class="img-pick" bindtap="onPickImage">
            <image wx:if="{{form.image}}" class="img-preview" src="{{form.image}}" mode="aspectFill" />
            <text wx:else class="img-placeholder">＋ 选择图片</text>
          </view>
        </view>
        <view class="field">
          <text class="field-label">描述</text>
          <textarea class="field-input textarea" value="{{form.desc}}" data-field="desc" bindinput="onField" placeholder="菜品描述" />
        </view>
        <view class="field">
          <text class="field-label">标签（可选）</text>
          <input class="field-input" value="{{form.tag}}" data-field="tag" bindinput="onField" placeholder="如：招牌 / 人气" />
        </view>

        <!-- 自定义配置项 -->
        <view class="field spec-field">
          <view class="spec-title">自定义配置项</view>
          <view class="spec-subtitle">如辣度、甜度、酸度等，可添加维度与选项值</view>

          <!-- 快捷添加 -->
          <view class="quick-row">
            <view
              wx:for="{{quickOptions}}" wx:key="*this"
              class="quick-chip {{util.isSpecAdded(form.specs, item) ? 'added' : ''}}"
              catchtap="onQuickAdd" data-name="{{item}}"
            >{{item}}</view>
          </view>

          <!-- 已有配置项 -->
          <view class="spec-item" wx:for="{{form.specs}}" wx:key="label" wx:for-index="sIdx">
            <view class="spec-item-head">
              <text class="spec-item-name">{{item.label}}</text>
              <view class="spec-item-del" catchtap="onSpecRemove" data-idx="{{sIdx}}">🗑</view>
            </view>
            <view class="spec-values">
              <view class="spec-value-chip" wx:for="{{item.options}}" wx:for-item="opt" wx:key="*this" wx:for-index="oIdx">
                {{opt}}
                <text class="chip-x" catchtap="onOptionRemove" data-sidx="{{sIdx}}" data-oidx="{{oIdx}}">✕</text>
              </view>
              <view wx:if="{{item.options.length === 0}}" class="spec-value-empty">暂无选项值，请在下方添加</view>
            </view>
            <view class="spec-add-row">
              <input class="spec-add-input" placeholder="添加{{item.label}}选项值"
                value="{{newValues[sIdx]}}" data-idx="{{sIdx}}" bindinput="onNewValueInput" />
              <view class="spec-add-btn" catchtap="onOptionAdd" data-idx="{{sIdx}}">＋</view>
            </view>
          </view>

          <!-- 新增配置项维度 -->
          <view class="spec-new-row">
            <input class="spec-new-input" placeholder="自定义配置项名称，如：份量"
              value="{{newSpecName}}" bindinput="onNewSpecName" />
            <view class="spec-new-btn" catchtap="onSpecAdd">＋ 添加</view>
          </view>
        </view>

        <view class="submit-btn" bindtap="onSave">{{form._id ? '保存修改' : '创建菜品'}}</view>
      </scroll-view>
    </view>
  </view>

  <!-- 商家端 tab -->
  <view class="admin-tabbar">
    <view class="atab active">🍜<text>菜品</text></view>
    <view class="atab" bindtap="goPage" data-url="/pages/admin/orders/index">📋<text>订单</text></view>
    <view class="atab" bindtap="goPage" data-url="/pages/admin/profile/index">👤<text>我的</text></view>
  </view>
</view>
