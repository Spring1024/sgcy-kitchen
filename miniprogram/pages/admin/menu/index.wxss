.admin-container { min-height: 100vh; background: #FAF3EC; padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }
.admin-header {
  background: linear-gradient(135deg, #1B1A16, #370617);
  padding: 60rpx 40rpx 40rpx; color: #fff;
}
.admin-title { font-size: 36rpx; font-weight: bold; }
.admin-sub { font-size: 22rpx; color: rgba(247,225,215,0.5); margin-top: 8rpx; }
.page { padding: 24rpx 32rpx; }
.search-box { background: #fff; border-radius: 16rpx; border: 1rpx solid rgba(55,6,23,0.08); }
.search-input { padding: 20rpx 24rpx; font-size: 26rpx; }
.add-btn {
  background: #E85D04; color: #fff; text-align: center;
  padding: 24rpx; border-radius: 16rpx; margin: 24rpx 0; font-weight: bold;
}
.dish {
  display: flex; gap: 20rpx; align-items: center;
  background: #fff; border-radius: 24rpx; padding: 20rpx; margin-bottom: 16rpx;
  border: 1rpx solid rgba(55,6,23,0.05);
}
.dish-img { width: 112rpx; height: 112rpx; border-radius: 16rpx; flex-shrink: 0; }
.dish-info { flex: 1; min-width: 0; }
.dish-name { font-size: 26rpx; font-weight: bold; }
.off-badge {
  font-size: 18rpx; color: rgba(55,6,23,0.5); background: rgba(55,6,23,0.08);
  padding: 2rpx 12rpx; border-radius: 999rpx; margin-left: 8rpx;
}
.dish-meta { font-size: 20rpx; color: rgba(55,6,23,0.4); margin-top: 6rpx; }
.dish-price { color: #E85D04; font-weight: bold; margin-top: 8rpx; }
.dish-actions { display: flex; flex-direction: column; gap: 12rpx; }
.act-btn {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: #FFF8F0; display: flex; align-items: center; justify-content: center;
  font-size: 28rpx;
}

.modal-mask { position: fixed; inset: 0; z-index: 60; background: rgba(0,0,0,0.5); display: flex; align-items: flex-end; }
.form-sheet {
  width: 100%; background: #fff; border-radius: 32rpx 32rpx 0 0;
  max-height: 88vh; display: flex; flex-direction: column;
}
.form-head {
  display: flex; justify-content: space-between; align-items: center;
  padding: 32rpx; border-bottom: 1rpx solid rgba(55,6,23,0.08);
}
.form-title { font-size: 30rpx; font-weight: bold; }
.form-close { width: 56rpx; height: 56rpx; border-radius: 50%; background: #FAF3EC; text-align: center; line-height: 56rpx; }
.form-body { padding: 24rpx 32rpx calc(60rpx + env(safe-area-inset-bottom)); }
.field { margin-bottom: 24rpx; }
.field-label { font-size: 24rpx; color: rgba(55,6,23,0.5); display: block; margin-bottom: 10rpx; }
.field-input {
  background: #FAF3EC; border-radius: 16rpx; padding: 20rpx 24rpx;
  font-size: 26rpx; border: 1rpx solid rgba(55,6,23,0.08); width: 100%; box-sizing: border-box;
}
.textarea { min-height: 120rpx; }
.field-row { display: flex; gap: 16rpx; }
.field.half { flex: 1; }
.cat-row { display: flex; flex-wrap: wrap; gap: 14rpx; }
.cat-chip {
  padding: 12rpx 24rpx; border-radius: 999rpx; font-size: 24rpx;
  background: #FAF3EC; color: rgba(55,6,23,0.5); border: 1rpx solid rgba(55,6,23,0.08);
}
.cat-chip.active { background: #E85D04; color: #fff; border-color: #E85D04; }
.img-pick {
  background: #FAF3EC; border-radius: 16rpx; height: 240rpx;
  display: flex; align-items: center; justify-content: center;
  border: 1rpx dashed rgba(55,6,23,0.15);
}
.img-preview { width: 100%; height: 100%; border-radius: 16rpx; }
.img-placeholder { color: rgba(55,6,23,0.4); font-size: 26rpx; }
.submit-btn {
  background: #E85D04; color: #fff; text-align: center;
  padding: 24rpx; border-radius: 16rpx; font-weight: bold; margin-top: 16rpx;
}

.admin-tabbar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
  background: rgba(27,26,22,0.95); border-top: 1rpx solid rgba(232,93,4,0.15);
  display: flex; justify-content: space-around; padding: 12rpx 0 calc(28rpx + env(safe-area-inset-bottom));
}
.atab {
  display: flex; flex-direction: column; align-items: center; gap: 4rpx;
  font-size: 28rpx; color: rgba(247,225,215,0.4);
}
.atab text { font-size: 20rpx; }
.atab.active { color: #E85D04; font-weight: bold; }
