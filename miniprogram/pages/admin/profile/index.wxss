.admin-container { min-height: 100vh; background: #FAF3EC; padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }
.admin-header {
  background: linear-gradient(135deg, #1B1A16, #370617);
  padding: 60rpx 40rpx 48rpx; color: #fff;
}
.shop-row { display: flex; align-items: center; gap: 24rpx; }
.shop-icon {
  width: 100rpx; height: 100rpx; border-radius: 24rpx; background: #E85D04;
  display: flex; align-items: center; justify-content: center; font-size: 44rpx;
}
.shop-info { flex: 1; }
.shop-name { font-size: 32rpx; font-weight: bold; }
.shop-sub { font-size: 22rpx; color: rgba(247,225,215,0.5); margin-top: 6rpx; }
.open-toggle {
  padding: 12rpx 24rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: bold;
  background: rgba(55,6,23,0.3); color: rgba(247,225,215,0.5);
}
.open-toggle.open { background: rgba(42,157,143,0.2); color: #2A9D8F; }
.page { padding: 24rpx 32rpx; }
.stats-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.stat-card {
  flex: 1; background: #fff; border-radius: 24rpx; padding: 28rpx 0;
  text-align: center; border: 1rpx solid rgba(55,6,23,0.05);
}
.stat-num { font-size: 34rpx; font-weight: bold; }
.stat-label { font-size: 20rpx; color: rgba(55,6,23,0.4); margin-top: 6rpx; }
.card {
  background: #fff; border-radius: 24rpx; padding: 28rpx; margin-bottom: 24rpx;
  border: 1rpx solid rgba(55,6,23,0.05);
}
.card-title { font-size: 28rpx; font-weight: bold; margin-bottom: 16rpx; }
.row { display: flex; align-items: center; gap: 16rpx; padding: 12rpx 0; }
.icon { font-size: 28rpx; }
.row-text { font-size: 26rpx; color: rgba(55,6,23,0.7); }
.switch-btn { height: 88rpx; font-size: 28rpx; }
.admin-tabbar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
  background: rgba(27,26,22,0.95); border-top: 1rpx solid rgba(232,93,4,0.15);
  display: flex; justify-content: space-around; padding: 12rpx 0 calc(28rpx + env(safe-area-inset-bottom));
}
.atab {
  display: flex; flex-direction: column; align-items: center; gap: 4rpx;
  font-size: 28rpx; color: rgba(247,225,215,0.4);
}
.atab text { font-size: 20rpx; }
.atab.active { color: #E85D04; font-weight: bold; }
