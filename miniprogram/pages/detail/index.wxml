<loading-mask show="{{loading}}" />
<view class="container" wx:if="{{dish}}">
  <image class="hero" src="{{dish.image}}" mode="aspectFill" />
  <view class="back-btn" bindtap="goBack">←</view>
  <view wx:if="{{dish.tag}}" class="hero-tag">{{dish.tag}}</view>

  <view class="content">
    <view class="main-card card">
      <view class="row-between">
        <view>
          <view class="dish-name">{{dish.name}}</view>
          <view class="dish-cat">{{dish.category}}</view>
        </view>
        <view class="dish-price">¥{{dish.price}}</view>
      </view>
      <view class="stats">
        <text>⭐ {{dish.rating || '4.5'}}</text>
        <text>月售 {{dish.sold || 0}}</text>
      </view>
      <view class="dish-desc">{{dish.desc}}</view>
    </view>

    <!-- 规格 -->
    <view class="card spec-card" wx:for="{{dish.specs}}" wx:key="label">
      <view class="spec-label">{{item.label}}</view>
      <view class="spec-options">
        <view
          wx:for="{{item.options}}"
          wx:for-item="opt"
          wx:key="*this"
          class="spec-opt {{selectedSpecs[item.label] === opt ? 'active' : ''}}"
          bindtap="selectSpec"
          data-label="{{item.label}}"
          data-value="{{opt}}"
        >{{opt}}</view>
      </view>
    </view>

    <!-- 数量 -->
    <view class="card row-between qty-card">
      <text class="spec-label">购买数量</text>
      <view class="qty-ctrl">
        <view class="qty-btn" bindtap="minus">−</view>
        <text class="qty-num">{{quantity}}</text>
        <view class="qty-btn plus" bindtap="plus">＋</view>
      </view>
    </view>
  </view>

  <view class="footer-bar">
    <view class="btn-primary add-cart-btn" bindtap="addToCart">
      加入购物车 ¥{{totalPrice}}
    </view>
  </view>
</view>
<view wx:elif="{{!loading}}" class="loading">菜品不存在</view>
