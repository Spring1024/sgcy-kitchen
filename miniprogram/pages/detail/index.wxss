.hero { width: 100%; height: 480rpx; }
.back-btn {
  position: fixed; top: 80rpx; left: 32rpx; z-index: 10;
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: rgba(255,255,255,0.9); text-align: center; line-height: 72rpx; font-size: 32rpx;
}
.hero-tag {
  position: absolute; top: 200rpx; left: 32rpx;
  background: #E85D04; color: #fff; font-size: 22rpx; font-weight: bold;
  padding: 8rpx 24rpx; border-radius: 999rpx;
}
.content { padding: 0 32rpx; margin-top: -80rpx; position: relative; z-index: 2; padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.main-card { box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.06); }
.row-between { display: flex; justify-content: space-between; align-items: flex-start; }
.dish-name { font-size: 40rpx; font-weight: bold; }
.dish-cat { font-size: 24rpx; color: rgba(55,6,23,0.5); margin-top: 8rpx; }
.dish-price { font-size: 48rpx; font-weight: bold; color: #E85D04; }
.stats { display: flex; gap: 32rpx; font-size: 24rpx; color: rgba(55,6,23,0.6); margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(55,6,23,0.05); }
.dish-desc { font-size: 26rpx; color: rgba(55,6,23,0.6); margin-top: 16rpx; line-height: 1.6; }
.spec-card { margin-top: 24rpx; }
.spec-label { font-size: 28rpx; font-weight: bold; margin-bottom: 20rpx; }
.spec-options { display: flex; flex-wrap: wrap; gap: 16rpx; }
.spec-opt {
  padding: 14rpx 28rpx; border-radius: 999rpx; font-size: 26rpx;
  border: 1rpx solid rgba(55,6,23,0.1); color: rgba(55,6,23,0.6); background: #fff;
}
.spec-opt.active { border-color: #E85D04; color: #E85D04; background: rgba(232,93,4,0.06); font-weight: bold; }
.qty-card { margin-top: 24rpx; }
.qty-ctrl { display: flex; align-items: center; gap: 20rpx; background: #FFF8F0; border-radius: 999rpx; padding: 8rpx 16rpx; }
.qty-btn {
  width: 56rpx; height: 56rpx; border-radius: 50%; background: #fff;
  border: 1rpx solid rgba(232,93,4,0.3); color: #E85D04;
  display: flex; align-items: center; justify-content: center; font-size: 30rpx;
}
.qty-btn.plus { background: #E85D04; color: #fff; }
.qty-num { font-size: 30rpx; font-weight: bold; min-width: 44rpx; text-align: center; }
.footer-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
  background: rgba(255,255,255,0.95); padding: 20rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(55,6,23,0.05);
}
.add-cart-btn { height: 96rpx; font-size: 30rpx; }
.loading { text-align: center; padding-top: 300rpx; color: rgba(55,6,23,0.4); }
