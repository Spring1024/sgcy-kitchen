.container { padding: 24rpx 32rpx; }
.empty { text-align: center; color: rgba(55,6,23,0.4); padding: 200rpx 0; font-size: 26rpx; }
.review-card {
  background: #fff; border-radius: 24rpx; padding: 28rpx; margin-bottom: 20rpx;
  border: 1rpx solid rgba(55,6,23,0.05);
}
.review-head { display: flex; justify-content: space-between; align-items: center; }
.dish-name { font-size: 28rpx; font-weight: bold; color: #370617; }
.stars { display: flex; gap: 6rpx; }
.star { font-size: 28rpx; color: rgba(55,6,23,0.12); }
.star.active { color: #E85D04; }
.review-content { font-size: 26rpx; color: rgba(55,6,23,0.7); margin-top: 16rpx; line-height: 1.6; }
.review-foot {
  display: flex; justify-content: space-between; margin-top: 16rpx;
  padding-top: 16rpx; border-top: 1rpx solid rgba(55,6,23,0.05);
}
.review-time { font-size: 22rpx; color: rgba(55,6,23,0.4); }
.order-id { font-size: 22rpx; color: rgba(55,6,23,0.3); }
