<loading-mask show="{{loading}}" />
<view class="container">
  <view wx:if="{{reviews.length === 0 && !loading}}" class="empty">暂无评价，完成订单后可评价</view>
  <view class="review-card" wx:for="{{reviews}}" wx:key="_id" bindtap="goOrder" data-id="{{item.orderId}}">
    <view class="review-head">
      <view class="dish-name">{{item.dishName}}</view>
      <view class="stars">
        <text wx:for="{{5}}" wx:for-item="s" wx:key="*this"
          class="star {{item.rating >= (index + 1) ? 'active' : ''}}"
        >★</text>
      </view>
    </view>
    <view wx:if="{{item.content}}" class="review-content">{{item.content}}</view>
    <view class="review-foot">
      <text class="review-time">{{item.timeLabel}}</text>
      <text class="order-id">{{item.orderId}}</text>
    </view>
  </view>
</view>
