.page-body { padding: 24rpx 32rpx; padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.card { margin-bottom: 24rpx; }
.card-title { font-size: 28rpx; font-weight: bold; margin-bottom: 16rpx; }

.type-tabs { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.type-tab {
  flex: 1; text-align: center; padding: 24rpx 0; border-radius: 20rpx;
  font-size: 26rpx; background: #FFF8F0; color: rgba(55,6,23,0.6);
}
.type-tab.active { background: #E85D04; color: #fff; font-weight: bold; }

.day-row { display: flex; gap: 12rpx; overflow-x: auto; margin-bottom: 20rpx; }
.day-item {
  flex-shrink: 0; padding: 12rpx 20rpx; border-radius: 16rpx;
  border: 1rpx solid rgba(55,6,23,0.08); background: #fff; text-align: center;
}
.day-item.active { border-color: #E85D04; background: rgba(232,93,4,0.05); }
.day-week { font-size: 20rpx; color: rgba(55,6,23,0.5); }
.day-item.active .day-week { color: #E85D04; font-weight: bold; }
.day-date { font-size: 26rpx; font-weight: bold; }

.time-row { display: flex; align-items: center; justify-content: center; gap: 16rpx; padding: 16rpx 0; }
.time-pick {
  background: #fff; border: 1rpx solid rgba(55,6,23,0.1); border-radius: 12rpx;
  padding: 12rpx 32rpx; font-size: 30rpx; font-weight: bold;
}
.time-sep { font-size: 32rpx; color: rgba(55,6,23,0.4); }
.time-summary { font-size: 26rpx; color: rgba(55,6,23,0.7); margin-top: 12rpx; }

.shop-line { font-size: 28rpx; font-weight: bold; margin-bottom: 20rpx; }
.tag-eat {
  font-size: 20rpx; font-weight: normal; color: #606C38;
  background: rgba(96,108,56,0.1); padding: 4rpx 14rpx; border-radius: 999rpx; margin-left: 12rpx;
}
.item { display: flex; align-items: center; gap: 20rpx; margin-bottom: 20rpx; }
.item-img { width: 100rpx; height: 100rpx; border-radius: 16rpx; flex-shrink: 0; }
.item-info { flex: 1; min-width: 0; }
.item-name { font-size: 26rpx; font-weight: bold; }
.item-spec { font-size: 20rpx; color: rgba(55,6,23,0.45); margin-top: 4rpx; }
.item-price { color: #E85D04; font-weight: bold; font-size: 26rpx; margin-top: 6rpx; }
.item-qty { font-size: 24rpx; color: rgba(55,6,23,0.5); }

.remark {
  width: 100%; background: #FFF8F0; border-radius: 16rpx; padding: 20rpx;
  font-size: 26rpx; min-height: 120rpx; box-sizing: border-box;
}

.price-row { display: flex; justify-content: space-between; font-size: 26rpx; padding: 8rpx 0; }
.total-row { border-top: 1rpx solid rgba(55,6,23,0.08); margin-top: 12rpx; padding-top: 20rpx; }
.total-num { font-size: 36rpx; font-weight: bold; }
.points-tip { font-size: 22rpx; color: #606C38; margin-top: 12rpx; }

.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
  background: rgba(255,255,255,0.95); border-top: 1rpx solid rgba(55,6,23,0.05);
  padding: 20rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 24rpx;
}
.total-box { flex: 1; }
.total-big { font-size: 44rpx; font-weight: bold; }
.submit-btn { padding: 0 64rpx; height: 96rpx; font-size: 30rpx; }
.submit-btn.disabled { opacity: 0.5; }
