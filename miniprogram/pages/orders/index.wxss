.tabs {
  position: sticky; top: 0; z-index: 20; display: flex; gap: 16rpx;
  background: #FFF8F0; padding: 16rpx 32rpx; border-bottom: 1rpx solid rgba(55,6,23,0.05);
}
.tab { padding: 12rpx 28rpx; border-radius: 999rpx; font-size: 26rpx; background: #fff; color: rgba(55,6,23,0.5); }
.tab.active { background: #E85D04; color: #fff; font-weight: bold; }
.list { padding: 24rpx 32rpx; }
.empty { text-align: center; color: rgba(55,6,23,0.4); padding: 160rpx 0; }
.order-card {
  background: #fff; border-radius: 24rpx; padding: 28rpx;
  border: 1rpx solid rgba(55,6,23,0.05); margin-bottom: 24rpx;
}
.order-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.order-shop { font-size: 28rpx; font-weight: bold; }
.order-type {
  font-size: 20rpx; font-weight: normal; color: #606C38;
  background: rgba(96,108,56,0.1); padding: 2rpx 14rpx; border-radius: 999rpx; margin-left: 10rpx;
}
.status-pending { color: #E85D04; font-size: 24rpx; }
.status-cooking { color: #FFB703; font-size: 24rpx; }
.status-done { color: #2A9D8F; font-size: 24rpx; }
.status-cancelled { color: rgba(55,6,23,0.4); font-size: 24rpx; }
.order-items { display: flex; gap: 16rpx; overflow-x: auto; margin-bottom: 16rpx; }
.order-item {
  display: flex; gap: 12rpx; align-items: center;
  background: #FFF8F0; border-radius: 16rpx; padding: 12rpx; flex-shrink: 0;
}
.oi-img { width: 72rpx; height: 72rpx; border-radius: 12rpx; }
.oi-name { font-size: 22rpx; font-weight: bold; max-width: 180rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.oi-qty { font-size: 20rpx; color: #E85D04; }
.order-foot {
  display: flex; justify-content: space-between; align-items: center;
  border-top: 1rpx solid rgba(55,6,23,0.05); padding-top: 16rpx;
}
.order-time { font-size: 22rpx; color: rgba(55,6,23,0.5); }
.order-total { font-size: 24rpx; color: rgba(55,6,23,0.6); }
