<view class="container">
  <view class="tabs">
    <view
      wx:for="{{tabs}}" wx:key="key"
      class="tab {{filter === item.key ? 'active' : ''}}"
      bindtap="setFilter" data-key="{{item.key}}"
    >{{item.label}}</view>
  </view>

  <view class="list">
    <view wx:if="{{orders.length === 0}}" class="empty">暂无相关订单</view>
    <view class="order-card" wx:for="{{orders}}" wx:key="orderId" bindtap="goDetail" data-id="{{item.orderId}}">
      <view class="order-head">
        <view class="order-shop">🏪 冒饭局
          <text class="order-type">{{item.type === 'today' ? '当天' : '预约'}}</text>
        </view>
        <text class="status-{{item.status}}">{{item.statusText}}</text>
      </view>
      <view class="order-items">
        <view class="order-item" wx:for="{{item.items}}" wx:for-item="it" wx:key="name">
          <image class="oi-img" src="{{it.image}}" mode="aspectFill" />
          <view>
            <view class="oi-name">{{it.name}}</view>
            <view class="oi-qty">×{{it.quantity}}</view>
          </view>
        </view>
      </view>
      <view class="order-foot">
        <text class="order-time">{{item.timeLabel}}</text>
        <view class="order-total">合计 <text class="text-accent text-bold">¥{{item.total}}</text></view>
      </view>
    </view>
  </view>
</view>
