<view class="container" wx:if="{{order}}">
  <view class="head card">
    <view class="order-id">{{order.orderId}}</view>
    <view class="status-badge status-{{order.status}}">{{order.statusText}}</view>
  </view>

  <view class="card">
    <view class="row"><text class="label">取餐方式</text><text>{{order.type === 'today' ? '当天到店' : '预约到店'}}</text></view>
    <view class="row"><text class="label">到店时间</text><text>{{order.timeLabel}}</text></view>
    <view class="row" wx:if="{{order.remark}}"><text class="label">备注</text><text>{{order.remark}}</text></view>
  </view>

  <view class="card">
    <view class="card-title">菜品明细</view>
    <view class="dish" wx:for="{{order.items}}" wx:key="name">
      <image class="dish-img" src="{{item.image}}" mode="aspectFill" />
      <view class="dish-info">
        <view class="dish-name">{{item.name}}</view>
        <view wx:if="{{item.specText}}" class="dish-spec">{{item.specText}}</view>
      </view>
      <view class="dish-right">
        <view class="dish-price">¥{{item.price}}</view>
        <view class="dish-qty">×{{item.quantity}}</view>
      </view>
    </view>
    <view class="price-row"><text class="text-muted">商品小计</text><text>¥{{order.subtotal}}</text></view>
    <view class="price-row"><text class="text-muted">打包费</text><text>¥{{order.packagingFee}}</text></view>
    <view class="price-row total"><text class="text-bold">合计</text><text class="text-accent text-bold big">¥{{order.total}}</text></view>
    <view class="points-tip" wx:if="{{order.pointsEarned > 0}}">本单{{order.status === 'done' ? '已获得' : '完成后可获得'}} {{order.pointsEarned}} 积分</view>
  </view>

  <!-- 评价区域：仅已完成订单显示 -->
  <view wx:if="{{order.status === 'done'}}" class="card review-card">
    <!-- 已评价：只读展示 -->
    <block wx:if="{{reviewed}}">
      <view class="card-title">我的评价</view>
      <view class="reviewed-item" wx:for="{{existingReviews}}" wx:key="_id">
        <view class="reviewed-head">
          <view class="review-dish-name">{{item.dishName}}</view>
          <view class="stars">
            <text wx:for="{{5}}" wx:for-item="s" wx:key="*this"
              class="star {{item.rating >= (index + 1) ? 'star-active' : ''}}"
            >★</text>
          </view>
        </view>
        <view wx:if="{{item.content}}" class="reviewed-content">{{item.content}}</view>
      </view>
      <view class="reviewed-tip">已完成评价，每个订单仅可评价一次</view>
    </block>

    <!-- 未评价：提交表单，每个菜品独立评价 -->
    <block wx:else>
      <view class="card-title">评价订单</view>
      <view class="review-form-item" wx:for="{{formReviews}}" wx:key="name" wx:for-index="fIdx">
        <view class="review-item-head">
          <view class="review-dish-name">{{item.name}}</view>
          <view class="stars">
            <text wx:for="{{5}}" wx:for-item="s" wx:key="*this"
              class="star {{item.rating >= (index + 1) ? 'star-active' : ''}}"
              catchtap="onRate" data-idx="{{fIdx}}" data-score="{{index + 1}}"
            >★</text>
          </view>
        </view>
        <textarea class="review-input" placeholder="说说这道菜味道如何？（选填）"
          value="{{item.content}}" data-idx="{{fIdx}}" bindinput="onContentInput" />
      </view>
      <view class="review-submit {{reviewSubmitting ? 'disabled' : ''}}" bindtap="submitReview">
        {{reviewSubmitting ? '提交中...' : '提交评价'}}
      </view>
    </block>
  </view>

  <view style="height: 160rpx"></view>

  <view wx:if="{{order.status === 'pending'}}" class="bottom-bar">
    <view class="btn-ghost cancel-btn" bindtap="cancelOrder">取消订单</view>
  </view>
</view>
<view wx:else class="loading">加载中...</view>
