.profile-head { display: flex; gap: 28rpx; padding: 48rpx 40rpx 32rpx; }
.avatar-btn {
  padding: 0; background: none; line-height: 1;
  border-radius: 50%; width: 160rpx; height: 160rpx;
  overflow: hidden; flex-shrink: 0;
}
.avatar-btn::after { border: none; }
.avatar { width: 160rpx; height: 160rpx; border-radius: 50%; display: block; }
.nickname-input {
  font-size: 36rpx; font-weight: bold; background: transparent;
  padding: 0; min-height: 48rpx;
}
.uid { font-size: 22rpx; color: rgba(55,6,23,0.45); margin-top: 8rpx; }
.stats { display: flex; gap: 40rpx; margin-top: 20rpx; }
.stat-num { font-size: 32rpx; font-weight: bold; }
.stat-label { font-size: 20rpx; color: rgba(55,6,23,0.5); margin-left: 6rpx; }

.menu-list { padding: 0 32rpx; }
.menu-item {
  display: flex; align-items: center; gap: 24rpx;
  background: #fff; border-radius: 24rpx; padding: 28rpx;
  border: 1rpx solid rgba(55,6,23,0.05); margin-bottom: 16rpx;
}
.menu-icon {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: rgba(232,93,4,0.1); display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; flex-shrink: 0;
}
.menu-body { flex: 1; min-width: 0; }
.menu-label { font-size: 28rpx; font-weight: bold; color: #370617; }
.menu-desc { font-size: 22rpx; color: rgba(55,6,23,0.4); margin-top: 4rpx; }
.menu-arrow { color: rgba(55,6,23,0.3); font-size: 36rpx; }
.admin-entry { background: #1B1A16; border-color: rgba(232,93,4,0.2); }
